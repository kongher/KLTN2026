generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum RoleName {
  CUSTOMER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  BANNED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum ScheduleStatus {
  AVAILABLE
  UNAVAILABLE
  OFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REJECTED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

enum EmailNotificationTargetType {
  ALL_STAFF
  ALL_CUSTOMER
  SPECIFIC
}

enum EmailRecipientStatus {
  PENDING
  SENT
  FAILED
}

enum EmailNotificationCategory {
  OPERATIONAL
  PROMOTIONAL
}

enum VoucherType {
  PERCENTAGE
  FIXED
}

enum VoucherStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CustomerCouponStatus {
  AVAILABLE
  RESERVED
  USED
  EXPIRED
  REVOKED
}

enum CouponEmailStatus {
  PENDING
  SENT
  FAILED
}

model Role {
  id        String   @id @default(uuid()) @db.Char(36)
  name      RoleName @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id        String     @id @default(uuid()) @db.Char(36)
  roleId    String     @db.Char(36)
  name      String     @db.VarChar(150)
  email     String     @unique @db.VarChar(191)
  phone     String     @unique @db.VarChar(20)
  password  String     @db.VarChar(255)
  avatar               String?  @db.VarChar(500)
  emailVerified        Boolean  @default(true)
  marketingEmailOptIn  Boolean  @default(true)
  status               UserStatus @default(ACTIVE)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  role                       Role                         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  customer                   Customer?
  staff                      Staff?
  notifications              Notification[]
  emailNotificationsCreated  EmailNotification[]          @relation("EmailNotificationsCreated")
  emailNotificationRecipients EmailNotificationRecipient[]

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model Customer {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @unique @db.Char(36)
  dateOfBirth DateTime? @db.Date
  gender      String?   @db.VarChar(20)
  address     String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  treatmentRecords TreatmentRecord[]
  reviews          Review[]
  customerCoupons  CustomerCoupon[]

  @@map("customers")
}

model Staff {
  id             String      @id @default(uuid()) @db.Char(36)
  userId         String      @unique @db.Char(36)
  specialization String?     @db.VarChar(150)
  status         StaffStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffServices    StaffService[]
  schedules        StaffSchedule[]
  bookings         Booking[]
  treatmentRecords TreatmentRecord[]
  reviews          Review[]

  @@index([status])
  @@map("staff")
}

model ServiceCategory {
  id          String         @id @default(uuid()) @db.Char(36)
  name        String         @unique @db.VarChar(150)
  description String?        @db.Text
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  services Service[]

  @@map("service_categories")
}

model Service {
  id          String        @id @default(uuid()) @db.Char(36)
  categoryId  String        @db.Char(36)
  code        String        @unique @db.VarChar(50)
  name        String        @db.VarChar(150)
  description String?       @db.Text
  price       Decimal       @db.Decimal(12, 2)
  duration    Int
  image       String?       @db.VarChar(500)
  status      ServiceStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category         ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  staffServices    StaffService[]
  bookings         Booking[]
  treatmentRecords TreatmentRecord[]
  reviews          Review[]

  @@index([categoryId])
  @@index([status])
  @@map("services")
}

model StaffService {
  id        String   @id @default(uuid()) @db.Char(36)
  staffId   String   @db.Char(36)
  serviceId String   @db.Char(36)
  createdAt DateTime @default(now())

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
  @@map("staff_services")
}

model StaffSchedule {
  id        String         @id @default(uuid()) @db.Char(36)
  staffId   String         @db.Char(36)
  date      DateTime       @db.Date
  startTime String         @db.VarChar(8)
  endTime   String         @db.VarChar(8)
  status    ScheduleStatus @default(AVAILABLE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date, startTime])
  @@index([staffId, date])
  @@index([staffId, date, status])
  @@index([status])
  @@map("staff_schedules")
}

model BookingDailySequence {
  dayKey       String @id @db.VarChar(8)
  lastSequence Int    @default(0)

  @@map("booking_daily_sequences")
}

model Booking {
  id          String        @id @default(uuid()) @db.Char(36)
  bookingCode String        @unique @db.VarChar(20)
  customerId  String        @db.Char(36)
  staffId     String        @db.Char(36)
  serviceId   String        @db.Char(36)
  voucherId          String?       @db.Char(36)
  customerCouponId   String?       @unique @db.Char(36)
  bookingDate DateTime      @db.Date
  startTime   String        @db.VarChar(8)
  endTime     String        @db.VarChar(8)
  status      BookingStatus @default(PENDING)
  note        String?       @db.Text
  totalPrice  Decimal       @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff           Staff            @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  voucher         Voucher?         @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  customerCoupon  CustomerCoupon?  @relation(fields: [customerCouponId], references: [id], onDelete: SetNull)
  treatmentRecord TreatmentRecord?
  reviews         Review[]

  @@index([customerId])
  @@index([staffId])
  @@index([serviceId])
  @@index([bookingDate])
  @@index([status])
  @@index([staffId, bookingDate, status])
  @@index([staffId, bookingDate, startTime, endTime])
  @@index([voucherId])
  @@index([bookingCode])
  @@map("bookings")
}

model TreatmentRecord {
  id          String   @id @default(uuid()) @db.Char(36)
  customerId  String   @db.Char(36)
  bookingId   String   @unique @db.Char(36)
  serviceId   String   @db.Char(36)
  staffId     String   @db.Char(36)
  note        String?  @db.Text
  beforeImage String?  @db.VarChar(500)
  afterImage  String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([staffId])
  @@index([serviceId])
  @@map("treatment_records")
}

model Review {
  id         String       @id @default(uuid()) @db.Char(36)
  customerId String       @db.Char(36)
  serviceId  String       @db.Char(36)
  staffId    String       @db.Char(36)
  bookingId  String       @unique @db.Char(36)
  rating     Int
  comment    String?      @db.Text
  status     ReviewStatus @default(VISIBLE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([serviceId])
  @@index([staffId])
  @@index([status])
  @@index([rating])
  @@map("reviews")
}

model Voucher {
  id                String        @id @default(uuid()) @db.Char(36)
  code              String        @unique @db.VarChar(50)
  name              String        @db.VarChar(150)
  description       String?       @db.Text
  type              VoucherType
  value             Decimal       @db.Decimal(12, 2)
  maxDiscountAmount Decimal?      @db.Decimal(12, 2)
  minOrderAmount    Decimal?      @db.Decimal(12, 2)
  startDate         DateTime      @db.Date
  endDate           DateTime      @db.Date
  usageLimit        Int
  usagePerCustomer  Int           @default(1)
  usedCount         Int           @default(0)
  isPersonalized    Boolean       @default(true)
  status            VoucherStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  bookings         Booking[]
  customerCoupons  CustomerCoupon[]

  @@index([status])
  @@index([startDate, endDate])
  @@map("vouchers")
}

model CustomerCoupon {
  id          String               @id @default(uuid()) @db.Char(36)
  voucherId   String               @db.Char(36)
  customerId  String               @db.Char(36)
  status      CustomerCouponStatus @default(AVAILABLE)
  assignedAt  DateTime             @default(now())
  reservedAt  DateTime?
  usedAt      DateTime?
  emailStatus CouponEmailStatus    @default(PENDING)
  emailSentAt DateTime?
  emailError  String?              @db.Text
  updatedAt   DateTime             @updatedAt

  voucher  Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking?

  @@unique([voucherId, customerId])
  @@index([customerId, status])
  @@index([voucherId])
  @@map("customer_coupons")
}

model Notification {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String   @db.Char(36)
  title       String   @db.VarChar(200)
  message     String   @db.Text
  actionLabel String?  @db.VarChar(100)
  actionPath  String?  @db.VarChar(255)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model SiteSetting {
  id        String   @id @db.VarChar(50)
  data      Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model EmailNotification {
  id          String                      @id @default(uuid()) @db.Char(36)
  title       String                      @db.VarChar(200)
  content     String                      @db.Text
  targetType  EmailNotificationTargetType
  category    EmailNotificationCategory   @default(OPERATIONAL)
  createdById String                      @db.Char(36)
  sentSuccess Int                         @default(0)
  sentFailed  Int                         @default(0)
  createdAt   DateTime                    @default(now())

  createdBy   User                         @relation("EmailNotificationsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  recipients  EmailNotificationRecipient[]

  @@index([createdById])
  @@index([createdAt])
  @@map("email_notifications")
}

model EmailNotificationRecipient {
  id             String               @id @default(uuid()) @db.Char(36)
  notificationId String               @db.Char(36)
  userId         String               @db.Char(36)
  email          String               @db.VarChar(191)
  status         EmailRecipientStatus @default(PENDING)
  sentAt         DateTime?
  errorMessage   String?              @db.Text

  notification EmailNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([userId])
  @@index([status])
  @@map("email_notification_recipients")
}

model RegistrationOtp {
  id             String    @id @default(uuid()) @db.Char(36)
  email          String    @db.VarChar(191)
  phone          String    @db.VarChar(20)
  name           String    @db.VarChar(150)
  passwordHash   String    @db.VarChar(255)
  otpHash        String    @db.VarChar(64)
  expiresAt      DateTime
  usedAt         DateTime?
  failedAttempts Int       @default(0)
  sendCount      Int       @default(1)
  lastSentAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([email, usedAt])
  @@map("registration_otps")
}
